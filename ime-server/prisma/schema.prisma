generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================== ENUMS ======================
enum Role {
  ADMIN
  DEAN
  CURATOR
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum LessonType {
  LECTURE
  PRACTICE
  SEMINAR
  LAB
  EXAM
  CONSULTATION
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  REJECTED
}

enum ConferenceProvider {
  YANDEX_TELEMOST
  ZOOM
  GOOGLE_MEET
  OTHER
}

enum NotificationType {
  MESSAGE
  HOMEWORK
  LESSON
  CONFERENCE
  GRADE

  HOMEWORK_CREATED
  HOMEWORK_GRADED
  MATERIAL_CREATED
  NEW_MESSAGE
  SYSTEM
}

enum MaterialType {
  FILE
  LINK
}

model Material {
  id String @id @default(cuid())

  title       String
  description String?

  type MaterialType

  url String

  fileName String?
  mimeType String?
  size     Int?

  subjectId String
  lessonId  String?
  teacherId String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([lessonId])
  @@index([teacherId])
}

// ====================== USERS ======================
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String?
  fullName     String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles              UserRole[]
  student            Student?
  teacher            Teacher?
  chatParticipants   ChatParticipant[]
  sentMessages       Message[]
  createdChats       Chat[]
  chatMembers        ChatMember[]
  conferencesCreated Conference[]
  conferenceMembers  ConferenceMember[]
  notifications      Notification[]
  attachments        MessageAttachment[]

  @@index([email])
  @@map("users")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

// ====================== FACULTY STRUCTURE ======================
model Faculty {
  id        String @id @default(cuid())
  name      String
  shortName String @unique

  departments Department[]
  createdAt   DateTime     @default(now())

  @@map("faculties")
}

model Department {
  id        String  @id @default(cuid())
  name      String
  shortName String?

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  teachers Teacher[]
  subjects Subject[]
  groups   Group[]

  createdAt DateTime @default(now())

  @@index([facultyId])
  @@map("departments")
}

model Group {
  id   String @id @default(cuid())
  name String

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  students  Student[]
  schedule  ScheduleEntry[]
  createdAt DateTime        @default(now())
  subjects  GroupSubject[]
  lessons   Lesson[]

  @@unique([name, departmentId])
  @@map("groups")
}

// ====================== PROFILES ======================
model Student {
  id            String  @id @default(cuid())
  userId        String  @unique
  groupId       String
  admissionYear Int?
  studentCode   String? @unique // номер студенческого

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  submissions HomeworkSubmission[]

  @@index([groupId])
  @@map("students")
}

model GroupSubject {
  id String @id @default(cuid())

  groupId   String
  subjectId String

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([groupId, subjectId])
}

model Teacher {
  id           String  @id @default(cuid())
  userId       String  @unique
  departmentId String?
  position     String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  subjects  SubjectTeacher[]
  lessons   Lesson[] // уже было
  homeworks Homework[]
  schedule  ScheduleEntry[] // ← ДОБАВЛЕНО (обратная связь)
  materials Material[]

  @@index([departmentId])
  @@map("teachers")
}

model Subject {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  credits     Int     @default(0)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  teachers    SubjectTeacher[]
  lessons     Lesson[]
  homeworks   Homework[]
  schedule    ScheduleEntry[]
  conferences Conference[]
  groups      GroupSubject[]
  materials   Material[]

  @@index([departmentId])
  @@map("subjects")
}

model SubjectTeacher {
  id        String @id @default(cuid())
  subjectId String
  teacherId String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
  @@map("subject_teachers")
}

// ====================== ACADEMIC ======================
model AcademicYear {
  id        String     @id @default(cuid())
  year      Int        @unique
  semesters Semester[]
  createdAt DateTime   @default(now())

  @@map("academic_years")
}

model Semester {
  id             String       @id @default(cuid())
  name           String
  number         Int
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  lessons   Lesson[]
  schedules ScheduleEntry[]
  createdAt DateTime        @default(now())

  @@unique([academicYearId, number])
  @@map("semesters")
}

// ====================== LESSONS ======================
model Lesson {
  id          String     @id @default(cuid())
  subjectId   String
  teacherId   String
  semesterId  String
  type        LessonType
  title       String
  description String?
  date        DateTime
  duration    Int
  location    String?

  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  groupId     String
  group       Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lecture     Lecture?
  video       Video?
  attachments MessageAttachment[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  homework  Homework[]
  materials Material[]

  @@index([subjectId])
  @@index([teacherId])
  @@map("lessons")
}

model Lecture {
  id String @id @default(cuid())

  lessonId String @unique

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  content String?

  slidesUrl String?

  createdAt DateTime @default(now())

  @@map("lectures")
}

model Video {
  id       String  @id @default(cuid())
  lessonId String? @unique // ← ИСПРАВЛЕНО: добавил @unique
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title     String
  url       String
  thumbnail String?
  duration  Int?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("videos")
}

// ====================== SCHEDULE ======================
model ScheduleEntry {
  id         String   @id @default(cuid())
  groupId    String
  subjectId  String
  teacherId  String
  semesterId String
  dayOfWeek  Int
  startTime  DateTime
  endTime    DateTime
  location   String?

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([teacherId])
  @@map("schedule_entries")
}

// ====================== HOMEWORK ======================
model Homework {
  id          String   @id @default(cuid())
  subjectId   String
  teacherId   String
  title       String
  description String
  deadline    DateTime
  maxScore    Int      @default(100)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  submissions HomeworkSubmission[]
  attachments MessageAttachment[]
  lessonId    String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homeworks")
}

model HomeworkSubmission {
  id          String           @id @default(cuid())
  homeworkId  String
  studentId   String
  status      SubmissionStatus @default(DRAFT)
  content     String?
  score       Int?
  feedback    String?
  submittedAt DateTime?
  gradedAt    DateTime?

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  attachments MessageAttachment[]

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
}

// ====================== COMMUNICATION ======================
enum ChatType {
  DIRECT
  GROUP
}

model ChatMember {
  id       String   @id @default(cuid())
  chatId   String
  userId   String
  joinedAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("chat_members")
}

model Chat {
  id String @id @default(cuid())

  type  ChatType @default(DIRECT)
  title String?

  /// Для DIRECT:
  /// sorted(userId1, userId2).join(":")
  directKey String? @unique

  participants ChatParticipant[]
  messages     Message[]

  lastMessageAt DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User?        @relation(fields: [userId], references: [id])
  userId      String?
  chatMembers ChatMember[]

  @@index([lastMessageAt])
}

model ChatParticipant {
  id String @id @default(cuid())

  chatId String
  userId String

  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@index([chatId])
}

model Message {
  id String @id @default(cuid())

  chatId   String
  senderId String

  text String?

  isEdited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  sender      User                @relation(fields: [senderId], references: [id])
  attachments MessageAttachment[]

  @@index([chatId, createdAt])
  @@index([senderId])
}

model Conference {
  id          String             @id @default(cuid())
  title       String
  description String?
  provider    ConferenceProvider @default(YANDEX_TELEMOST)
  link        String
  startTime   DateTime
  endTime     DateTime
  createdById String
  subjectId   String?

  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  subject   Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  members   ConferenceMember[]

  createdAt DateTime @default(now())

  @@index([startTime])
  @@map("conferences")
}

model ConferenceMember {
  id           String    @id @default(cuid())
  conferenceId String
  userId       String
  joinedAt     DateTime?

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId])
  @@map("conference_members")
}

model Notification {
  id     String @id @default(cuid())
  userId String

  type NotificationType

  title   String
  message String

  data Json?

  isRead Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model MessageAttachment {
  id String @id @default(cuid())

  messageId String

  url      String
  fileName String
  mimeType String
  size     Int

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt            DateTime            @default(now())
  user                 User?               @relation(fields: [userId], references: [id])
  userId               String?
  lesson               Lesson?             @relation(fields: [lessonId], references: [id])
  lessonId             String?
  homework             Homework?           @relation(fields: [homeworkId], references: [id])
  homeworkId           String?
  homeworkSubmission   HomeworkSubmission? @relation(fields: [homeworkSubmissionId], references: [id])
  homeworkSubmissionId String?

  @@index([messageId])
}
