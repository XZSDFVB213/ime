generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================== ENUMS ======================
enum Role {
  ADMIN
  DEAN
  CURATOR
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum LessonType {
  LECTURE
  PRACTICE
  SEMINAR
  LAB
  EXAM
  CONSULTATION
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  REJECTED
}

enum ConferenceProvider {
  YANDEX_TELEMOST
  ZOOM
  GOOGLE_MEET
  OTHER
}

enum NotificationType {
  MESSAGE
  HOMEWORK
  LESSON
  CONFERENCE
  GRADE
  SYSTEM
}

// ====================== USERS ======================
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String?
  fullName     String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles   UserRole[]
  student Student?
  teacher Teacher?

  createdChats       Chat[]
  chatMembers        ChatMember[]
  messagesSent       Message[]
  conferencesCreated Conference[]
  conferenceMembers  ConferenceMember[]
  notifications      Notification[]
  attachments        Attachment[]

  @@index([email])
  @@map("users")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

// ====================== FACULTY STRUCTURE ======================
model Faculty {
  id        String @id @default(cuid())
  name      String
  shortName String @unique

  departments Department[]
  createdAt   DateTime     @default(now())

  @@map("faculties")
}

model Department {
  id        String  @id @default(cuid())
  name      String
  shortName String?

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  teachers Teacher[]
  subjects Subject[]
  groups   Group[]

  createdAt DateTime @default(now())

  @@index([facultyId])
  @@map("departments")
}

model Group {
  id   String @id @default(cuid())
  name String

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  students  Student[]
  schedule  ScheduleEntry[]
  createdAt DateTime        @default(now())
  subjects  GroupSubject[]
  lessons   Lesson[]

  @@unique([name, departmentId])
  @@map("groups")
}

// ====================== PROFILES ======================
model Student {
  id            String  @id @default(cuid())
  userId        String  @unique
  groupId       String
  admissionYear Int?
  studentCode   String? @unique // номер студенческого

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  submissions HomeworkSubmission[]

  @@index([groupId])
  @@map("students")
}

model GroupSubject {
  id String @id @default(cuid())

  groupId   String
  subjectId String

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([groupId, subjectId])
}

model Teacher {
  id           String  @id @default(cuid())
  userId       String  @unique
  departmentId String?
  position     String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  subjects  SubjectTeacher[]
  lessons   Lesson[] // уже было
  homeworks Homework[]
  schedule  ScheduleEntry[] // ← ДОБАВЛЕНО (обратная связь)

  @@index([departmentId])
  @@map("teachers")
}

model Subject {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  credits     Int     @default(0)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  teachers    SubjectTeacher[]
  lessons     Lesson[]
  homeworks   Homework[]
  schedule    ScheduleEntry[]
  conferences Conference[]
  groups      GroupSubject[]

  @@index([departmentId])
  @@map("subjects")
}

model SubjectTeacher {
  id        String @id @default(cuid())
  subjectId String
  teacherId String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
  @@map("subject_teachers")
}

// ====================== ACADEMIC ======================
model AcademicYear {
  id        String     @id @default(cuid())
  year      Int        @unique
  semesters Semester[]
  createdAt DateTime   @default(now())

  @@map("academic_years")
}

model Semester {
  id             String       @id @default(cuid())
  name           String
  number         Int
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  lessons   Lesson[]
  schedules ScheduleEntry[]
  createdAt DateTime        @default(now())

  @@unique([academicYearId, number])
  @@map("semesters")
}

// ====================== LESSONS ======================
model Lesson {
  id          String     @id @default(cuid())
  subjectId   String
  teacherId   String
  semesterId  String
  type        LessonType
  title       String
  description String?
  date        DateTime
  duration    Int
  location    String?

  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lecture     Lecture?
  video       Video?
  attachments Attachment[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  homework  Homework[]

  @@index([subjectId])
  @@index([teacherId])
  @@map("lessons")
}

model Lecture {
  id String @id @default(cuid())

  lessonId String @unique

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  content String?

  slidesUrl String?

  createdAt DateTime @default(now())

  @@map("lectures")
}

model Video {
  id       String  @id @default(cuid())
  lessonId String? @unique // ← ИСПРАВЛЕНО: добавил @unique
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title     String
  url       String
  thumbnail String?
  duration  Int?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("videos")
}

// ====================== SCHEDULE ======================
model ScheduleEntry {
  id         String   @id @default(cuid())
  groupId    String
  subjectId  String
  teacherId  String
  semesterId String
  dayOfWeek  Int
  startTime  DateTime
  endTime    DateTime
  location   String?

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([teacherId])
  @@map("schedule_entries")
}

// ====================== HOMEWORK ======================
model Homework {
  id          String   @id @default(cuid())
  subjectId   String
  teacherId   String
  title       String
  description String
  deadline    DateTime
  maxScore    Int      @default(100)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  submissions HomeworkSubmission[]
  attachments Attachment[]
  lessonId    String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homeworks")
}

model HomeworkSubmission {
  id          String           @id @default(cuid())
  homeworkId  String
  studentId   String
  status      SubmissionStatus @default(DRAFT)
  content     String?
  score       Int?
  feedback    String?
  submittedAt DateTime?
  gradedAt    DateTime?

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
}

// ====================== COMMUNICATION ======================
model Chat {
  id          String  @id @default(cuid())
  name        String?
  isGroupChat Boolean @default(false)
  createdById String?

  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatMember[]
  messages  Message[]

  createdAt DateTime @default(now())

  @@map("chats")
}

model ChatMember {
  id       String   @id @default(cuid())
  chatId   String
  userId   String
  joinedAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("chat_members")
}

model Message {
  id        String    @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  replyToId String?
  editedAt  DateTime?
  deletedAt DateTime?

  chat        Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo     Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     Message[]    @relation("MessageReplies")
  attachments Attachment[]

  createdAt DateTime @default(now())

  @@index([chatId])
  @@map("messages")
}

model Conference {
  id          String             @id @default(cuid())
  title       String
  description String?
  provider    ConferenceProvider @default(YANDEX_TELEMOST)
  link        String
  startTime   DateTime
  endTime     DateTime
  createdById String
  subjectId   String?

  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  subject   Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  members   ConferenceMember[]

  createdAt DateTime @default(now())

  @@index([startTime])
  @@map("conferences")
}

model ConferenceMember {
  id           String    @id @default(cuid())
  conferenceId String
  userId       String
  joinedAt     DateTime?

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, userId])
  @@map("conference_members")
}

model Notification {
  id       String           @id @default(cuid())
  userId   String
  type     NotificationType
  title    String
  body     String
  entityId String?
  isRead   Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model Attachment {
  id           String @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  uploadedById String

  lessonId     String?
  homeworkId   String?
  submissionId String?
  messageId    String?

  uploadedBy User                @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  lesson     Lesson?             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  homework   Homework?           @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  submission HomeworkSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  message    Message?            @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("attachments")
}
